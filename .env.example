# ==========================================
# Database Configuration (Neon Serverless Postgres / PostgreSQL)
# ==========================================
# Pooled connection string (used by Prisma for runtime queries)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct / unpooled connection string (used for Prisma migrations and schema push)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Auth.js / NextAuth Configuration
# ==========================================
# Generate with: npx auth secret (or node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="your_generated_auth_secret_here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# Email Service (Resend)
# Used for email verification, password reset, and 2FA OTP codes
# ==========================================
# Resend Dashboard -> API Keys -> Create API Key (Sending access)
RESEND_API_KEY="re_your_resend_api_key"

# ==========================================
# OAuth Providers
# ==========================================
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# GitHub -> Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
